# Cloudflare Turnstile site key (public, safe to expose client-side — not a
# secret). Leave unset for local dev: the app falls back to Cloudflare's
# official "always passes" test key, which works on any hostname.
#
# For a real deployment, create a Turnstile widget at
# https://dash.cloudflare.com/ -> Turnstile, restricted to your real
# hostname, then set this as a build environment variable in the Cloudflare
# Worker's dashboard settings (not committed here).
VITE_TURNSTILE_SITE_KEY=
